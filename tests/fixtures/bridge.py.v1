        return 1
    except Exception as e:  # noqa: BLE001 - surface the real failure
        print(json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"},
                         ensure_ascii=False))
        return 1
    print(json.dumps(outcome, ensure_ascii=False))
    return 0


