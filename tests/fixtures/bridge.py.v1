                             ensure_ascii=False))
            return 2
        to_user = to_user or task.get("from_user_id")
        context_token = context_token or task.get("context_token")
    if not to_user:
        print(json.dumps({"ok": False,
                          "error": "need --task-id or --to-user"},
                         ensure_ascii=False))
        return 2
    try:
        outcome = send_file(creds, to_user, Path(args.file),
                            context_token, caption=args.caption)
    except ApiError as e:
        print(json.dumps({"ok": False, "error": f"{e.kind}: {e}"},
